# Copy to .env.production (gitignored), chmod 600; replace all placeholders.
GIIM_DOMAIN=giim.your-domain.example
POSTGRES_USER=giim
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
POSTGRES_DB=giim
DATABASE_URL=postgresql+asyncpg://giim:REPLACE_WITH_SAME_RANDOM_HEX@postgres:5432/giim
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
APP_ENV=production
LOG_LEVEL=INFO
INGESTION_TRIGGER_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
CORS_ORIGINS=
PIPELINE_MAX_LLM_CALLS=20
