# No credential is needed for default fake mode or --demo.
GIIM_API_URL=http://127.0.0.1:8000
GIIM_AGENT_MODEL=gemini-3.5-flash-lite
GIIM_RESEARCHER_MODEL=
GIIM_VERIFIER_MODEL=
# Both explicit opt-in and a privately provided key are required for --live.
GIIM_ENABLE_LIVE_GEMINI=0
GOOGLE_API_KEY=
# Set current operator-reviewed USD per million rates; unknown cost remains null.
GIIM_MODEL_PRICES={}
# ADK CLI/web safe demo entry defaults.
GIIM_ADK_DEMO=1
GIIM_ADK_LIVE=0
GIIM_TRACE_DIR=.runs
# Real publisher evidence remains withheld until separately authorized.
GIIM_MCP_PUBLISHER_CAPS={}
