# Local development template. Never place real credentials in this file.
# Generate .env using the README instructions; do not overwrite an existing .env.
APP_ENV=dev
LOG_LEVEL=INFO

POSTGRES_USER=giim
POSTGRES_DB=giim
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
DATABASE_URL=postgresql+asyncpg://giim:REPLACE_WITH_RANDOM_HEX@postgres:5432/giim
# Tests require their own migrated database; its name MUST end in _test.
TEST_DATABASE_URL=postgresql+asyncpg://giim:REPLACE_WITH_RANDOM_HEX@postgres:5432/giim_test

QDRANT_URL=http://qdrant:6333
# Empty for the loopback-only development service; never expose it publicly.
QDRANT_API_KEY=
INGESTION_TRIGGER_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN

# Optional: set privately in .env for AI summaries and paid integration tests.
# Blank credentials retain the source-excerpt fallback.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
PIPELINE_MAX_LLM_CALLS=20

# Local dense embeddings; model files are downloaded separately, never committed.
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_CACHE_DIR=/app/.cache/huggingface
EMBEDDING_DEVICE=cpu
CORS_ORIGINS=

# Legacy compatibility fields; these are not separate implemented integrations.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_API_KEY=
