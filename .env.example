# 运行环境：dev 或 prod
APP_ENV=dev

# 日志级别：DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO

# PostgreSQL 异步连接串（SQLAlchemy + asyncpg）
# 格式示例：postgresql+asyncpg://user:password@postgres:5432/giim
DATABASE_URL=postgresql+asyncpg://giim:giim@postgres:5432/giim

# PostgreSQL 容器初始化配置（用于 docker-compose）
POSTGRES_USER=giim
POSTGRES_PASSWORD=giim
POSTGRES_DB=giim

# Qdrant 服务地址（本地默认使用 Docker 服务名）
QDRANT_URL=http://qdrant:6333

# Qdrant API Key（本地开发可留空）
QDRANT_API_KEY=

# Day 4 使用：LLM Provider Key
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Day 4 使用：Embedding Provider Key（SiliconFlow）
EMBEDDING_API_KEY=

# Day 3：触发采集 POST /api/v1/ingestion/trigger 的 query token（生产务必修改）
INGESTION_TRIGGER_TOKEN=dev-trigger-token-change-me

# LLM (DeepSeek)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# LLM Embedding (本地 bge-m3)
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_CACHE_DIR=/app/.cache/huggingface
EMBEDDING_DEVICE=cpu
